# Caddy — TLS termination + reverse proxy for the receptionist stack.
#
# 1. Replace `receptionist.example.com` with your real domain.
# 2. Point the domain's A/AAAA records at the server's public IP.
# 3. Caddy auto-provisions Let's Encrypt certificates on first request.

(common_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

receptionist.example.com {
    import common_headers

    # Public dashboard
    reverse_proxy dashboard:3000

    # Public API (docs at /docs, OpenAPI at /openapi.json)
    reverse_proxy /docs*, /openapi.json, /auth/*, /calls/*, /messages/*, /appointments/*, /contacts/*, /config/*, /knowledge/*, /healthz api:8000

    # Telnyx media stream (WebSocket)
    @websockets path /media/*
    reverse_proxy @websockets agent:8765

    # Telnyx call-control webhook
    reverse_proxy /webhooks/* agent:8765
}

# Internal-only API surface (same hostname, no public listing).
# /internal/* is intentionally NOT reverse-proxied at the public hostname.
# It's reachable only via the docker network between api and agent.