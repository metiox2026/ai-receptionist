# =============================================================================
# AI Phone Receptionist — environment variables
#
# Copy to .env and fill in. The app refuses to start if a required variable
# (marked REQUIRED) is missing. Optional services stay disabled until their
# section is uncommented.
# =============================================================================

# ---------- General ----------
# Public URL the agent and api are reached on. Used to build webhook URLs.
PUBLIC_BASE_URL=https://receptionist.example.com
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me             # Flask-style shared secret for signed cookies / CSRF

# =============================================================================
# Telephony — Telnyx
# =============================================================================
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=             # E.164, the number the receptionist answers on
TELNYX_CONNECTION_ID=            # Call Control connection id from the portal
TELNYX_FALLBACK_NUMBER=          # Where to forward if everything is down

# =============================================================================
# Speech-to-Text — Deepgram
# =============================================================================
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# =============================================================================
# Text-to-Speech — Cartesia
# =============================================================================
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=               # Voice id from Cartesia's library
CARTESIA_MODEL=sonic-2

# =============================================================================
# LLM — Anthropic (primary) + Google Gemini (fallback)
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite

# Optional: OpenAI for embeddings / extra fallback
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Postgres (used by api, agent, worker, and dashboard indirectly)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=
POSTGRES_DB=receptionist
DATABASE_URL=postgresql+asyncpg://receptionist:CHANGE_ME@postgres:5432/receptionist

# =============================================================================
# Redis (cache + job queue)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Calendar — Google Calendar OAuth (for booking tool)
# =============================================================================
# Create OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Per-business calendar id; default calendar used if blank
GOOGLE_CALENDAR_DEFAULT_ID=primary

# =============================================================================
# Notifications (for messages, alerts, daily report)
# =============================================================================
# Telegram bot for staff alerts. Free, easy to set up.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Email via SMTP (or use a transactional provider below)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Receptionist <noreply@example.com>

# Optional: Resend / SendGrid
RESEND_API_KEY=
SENDGRID_API_KEY=

# Slack webhook (P2)
SLACK_WEBHOOK_URL=

# =============================================================================
# Object storage — call recordings
# =============================================================================
# S3-compatible. Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO.
RECORDINGS_BUCKET=receptionist-recordings
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_REGION=auto
RECORDINGS_ACCESS_KEY=
RECORDINGS_SECRET_KEY=
RECORDINGS_PUBLIC_URL=

# =============================================================================
# Cost caps (defense in depth)
# =============================================================================
MAX_CALL_DURATION_SEC=600        # 10 minutes
MAX_DAILY_SPEND_USD=50
MAX_TOOL_CALLS_PER_CALL=10
MAX_CONCURRENT_CALLS=20

# =============================================================================
# Dashboard — Next.js
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# =============================================================================
# Observability (optional — uncomment to use)
# =============================================================================
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus